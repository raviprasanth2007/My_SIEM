# ==============================================================================
# MY SIEM — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your local values.
# NEVER commit the actual '.env' file or secret credentials to Git.
# ==============================================================================

# Mapbox Public Access Token (restricted public pk.* token for browser map rendering)
# Obtain from: https://account.mapbox.com/access-tokens/
MAPBOX_PUBLIC_TOKEN=pk.your_restricted_mapbox_public_token_here

# Mapbox Secret Access Token (backend-only sk.* token for server operations if needed)
# Keep blank or placeholder if only client-side map rendering is used.
MAPBOX_SECRET_TOKEN=sk.your_mapbox_secret_token_here

# SIEM Server & Agent Network Configuration
SIEM_SERVER_IP=100.90.174.77
SIEM_SERVER_PORT=9999
SIEM_API_PORT=5000
AGENT_ID=omen-kali

